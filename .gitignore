# =============================================================================
# 用户上传 / 导出文件（运行时生成，勿提交 Git）
# 对应 backend/app/config/path_conf.py：
#   UPLOAD_DIR   = backend/static/upload
#   DOWNLOAD_DIR = backend/static/download
# 内置静态资源（如 static/image、static/swagger）仍正常纳入版本库
# =============================================================================

backend/static/upload/**
!backend/static/upload/.gitkeep

backend/static/download/**
!backend/static/download/.gitkeep
backend/app/api/v1/module_monitor/**
backend/app/api/v1/module_system/**
backend/devops/postgres/**
backend/devops/redis/**

.pnpm-store/**
.tools/**
.pids/**
.logs/**
.data/**
devops/**