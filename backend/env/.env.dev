# ==================================
# 开发环境配置（与 docker-compose.yml 对齐）
# ==================================

ENVIRONMENT = "dev"

# 服务器配置
SERVER_HOST = "localhost"
SERVER_PORT = 8001

# 文档配置
DEBUG = True
TITLE = "嘉期新媒体科技CRM -dev"
VERSION = "0.1.0"
SUMMARY = "接口汇总"
DOCS_URL = "/docs"
REDOC_URL = "/redoc"
ROOT_PATH = "/api/v1"
DESCRIPTION = "该项目是一个基于python的web服务框架，基于fastapi和sqlalchemy实现。"

DEMO_ENABLE = False

# 数据库配置（PostgreSQL，与 docker-compose 一致）
DATABASE_TYPE = "postgres"
DATABASE_HOST = "localhost"
DATABASE_PORT = 5432
DATABASE_USER = "postgres"
DATABASE_PASSWORD = "FastapiAdmin@2026"
DATABASE_NAME = "fastapiadmin"

# Redis配置（与 docker-compose 一致）
REDIS_ENABLE = True
REDIS_HOST = "localhost"
REDIS_PORT = 6379
REDIS_USER = ""
REDIS_PASSWORD = "FastapiAdmin@2026"
REDIS_DB_NAME = 1

# 日志配置
LOGGER_LEVEL = "DEBUG"

# 大模型配置
OPENAI_BASE_URL = "https://api.deepseek.com"
OPENAI_API_KEY = "your_api_key"
OPENAI_MODEL = "deepseek-chat"
